from fastapi import APIRouter, Query
from typing import Optional
from services import fotos_repository as repo

router = APIRouter(prefix="/fotos", tags=["fotos"])

# --- F7: Filtragem ---
@router.get("/")
def get_fotos(
    evento: Optional[str] = Query(None),
    ano: Optional[int] = Query(None),
    formato: Optional[str] = Query(None),
    categoria: Optional[str] = Query(None)
):
    return repo.filtrar_fotos(evento, ano, formato, categoria)

# --- F8: Estatísticas ---
@router.get("/estatisticas")
def get_estatisticas():
    return repo.calcular_estatisticas()

# --- F9: Integridade ---
@router.get("/{id}/integridade")
def get_integridade(id: int):
    return repo.verificar_integridade(id)

# --- F16: Estatísticas específicas ---
@router.get("/estatisticas/tema")
def get_estatisticas_tema():
    return repo.calcular_estatisticas_tema()
